{
    "name": "reqly",
    "publisher": "arturbomtempo-dev",
    "displayName": "Reqly for VS Code",
    "description": "A modern, lightweight HTTP client that brings the Reqly experience directly into VS Code.",
    "version": "1.1.0",
    "icon": "media/icon.png",
    "license": "MIT",
    "author": {
        "name": "Artur Bomtempo Colen",
        "url": "https://www.arturbomtempo.dev"
    },
    "homepage": "https://github.com/reqly-labs/vscode-extension#readme",
    "bugs": {
        "url": "https://github.com/reqly-labs/vscode-extension/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/reqly-labs/vscode-extension"
    },
    "galleryBanner": {
        "color": "#1B2620",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.134.0"
    },
    "categories": [
        "Other",
        "Testing"
    ],
    "keywords": [
        "http",
        "rest",
        "api",
        "client",
        "reqly",
        "curl",
        "request",
        "endpoint",
        "testing",
        "collections"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "reqly.newRequest",
                "title": "New Request",
                "category": "Reqly",
                "icon": "$(add)"
            },
            {
                "command": "reqly.newCollection",
                "title": "New Collection",
                "category": "Reqly",
                "icon": "$(new-folder)"
            },
            {
                "command": "reqly.openPanel",
                "title": "Open HTTP Client",
                "category": "Reqly"
            },
            {
                "command": "reqly.sendRequest",
                "title": "Send Request",
                "category": "Reqly",
                "icon": "$(play)"
            },
            {
                "command": "reqly.saveRequest",
                "title": "Save Request",
                "category": "Reqly",
                "icon": "$(save)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "reqly",
                    "title": "Reqly",
                    "icon": "media/reqly.svg"
                }
            ]
        },
        "views": {
            "reqly": [
                {
                    "type": "webview",
                    "id": "reqly.collections",
                    "name": "Reqly",
                    "icon": "media/reqly.svg"
                }
            ]
        },
        "keybindings": [
            {
                "command": "reqly.sendRequest",
                "key": "ctrl+alt+enter",
                "mac": "cmd+alt+enter"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "reqly.newRequest",
                    "when": "view == reqly.collections",
                    "group": "navigation@1"
                },
                {
                    "command": "reqly.newCollection",
                    "when": "view == reqly.collections",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p tsconfig.test.json",
        "watch-tests": "tsc -p tsconfig.test.json -w",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@reqly/design-system": "^1.1.1"
    },
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.134.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "jsdom": "^29.1.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
