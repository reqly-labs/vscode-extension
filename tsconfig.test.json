{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "rootDir": "src",
        "outDir": "out",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/test", "src/core", "src/http"]
}
