{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "mocha"],
        "rootDir": "src",
        "outDir": "out",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "paths": {
            "@reqly/design-system": ["./node_modules/@reqly/design-system/dist/index.d.cts"]
        }
    },
    "include": ["src/test", "src/core", "src/http", "src/services", "src/utils", "src/webview"],
    "exclude": ["src/webview/main.ts", "src/environments/main.ts", "src/collections/main.ts"]
}
